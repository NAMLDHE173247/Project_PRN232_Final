@model string
@{
    ViewData["Title"] = $"{Model} Marketplace";
    var email = Context.Session.GetString("MarketplaceEmail");
}
<section class="login-card" aria-labelledby="marketplace-home-title">
    <h1 id="marketplace-home-title" class="h3 mb-2">@Model Marketplace</h1>
    <p class="text-muted">Đăng nhập thành công. Khu vực chức năng @Model đang để trống để kiểm thử flow.</p>
    <p class="small mb-4">Tài khoản: <strong>@email</strong></p>
    <form asp-controller="MarketplaceAccount" asp-action="Logout" method="post">
        <button class="btn btn-outline-danger w-100" type="submit">Đăng xuất</button>
    </form>
</section>
