@model PagedViewModel<AuditLogViewModel>
@{ ViewData["Title"] = "Audit Logs"; }
<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
        <h1 class="page-title">Audit Logs</h1>
        <p>Lịch sử thao tác quản trị của hệ thống.</p>
    </div>
    <a class="btn btn-outline-success" asp-action="Export" asp-route-search="@ViewBag.Search" asp-route-action="@ViewBag.Action" asp-route-resource="@ViewBag.Resource" asp-route-actorId="@ViewBag.ActorId" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" asp-route-sort="@ViewBag.Sort" asp-route-direction="@ViewBag.Direction">Xuất Excel</a>
</div>
<form method="get" class="panel mb-3 row g-2 align-items-end">
    <div class="col-sm-6 col-lg-3"><label class="form-label" for="search">Tìm kiếm</label><input class="form-control" id="search" name="search" value="@ViewBag.Search" placeholder="Action, resource, metadata" /></div>
    <div class="col-sm-6 col-lg-2"><label class="form-label" for="action">Action</label><input class="form-control" id="action" name="action" value="@ViewBag.Action" placeholder="BLOCK_USER" /></div>
    <div class="col-sm-6 col-lg-2"><label class="form-label" for="resource">Resource</label><input class="form-control" id="resource" name="resource" value="@ViewBag.Resource" placeholder="USER" /></div>
    <div class="col-sm-6 col-lg-1"><label class="form-label" for="actorId">Actor</label><input class="form-control" id="actorId" name="actorId" type="number" min="1" value="@ViewBag.ActorId" /></div>
    <div class="col-sm-6 col-lg-2"><label class="form-label" for="from">Từ ngày</label><input class="form-control" id="from" name="from" type="date" value="@(ViewBag.From is DateTime from ? from.ToString("yyyy-MM-dd") : "")" /></div>
    <div class="col-sm-6 col-lg-2"><label class="form-label" for="to">Đến ngày</label><input class="form-control" id="to" name="to" type="date" value="@(ViewBag.To is DateTime to ? to.ToString("yyyy-MM-dd") : "")" /></div>
    <div class="col-sm-6 col-lg-2"><label class="form-label" for="direction">Thứ tự thời gian</label><select class="form-select" id="direction" name="direction"><option value="desc" selected="@(ViewBag.Direction != "asc")">Mới nhất</option><option value="asc" selected="@(ViewBag.Direction == "asc")">Cũ nhất</option></select><input type="hidden" name="sort" value="time" /></div>
    <div class="col-auto"><button class="btn btn-primary" type="submit">Lọc</button> <a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a></div>
</form>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Thời gian UTC</th><th>Actor</th><th>Action</th><th>Resource</th><th>Metadata</th></tr></thead><tbody>
@foreach (var log in Model.Items)
{
    <tr><td>@log.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm:ss")</td><td>@log.ActorId</td><td><strong>@log.Action</strong></td><td>@log.Resource #@log.ResourceId</td><td><small>@log.Metadata</small></td></tr>
}
</tbody></table></div>
<div class="mt-3 d-flex justify-content-between"><span class="text-muted">Trang @Model.Page / @Model.TotalPages · @Model.Total bản ghi</span><div class="btn-group"><a class="btn btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-route-page="@(Model.Page - 1)" asp-route-search="@ViewBag.Search" asp-route-action="@ViewBag.Action" asp-route-resource="@ViewBag.Resource" asp-route-actorId="@ViewBag.ActorId" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" asp-route-sort="@ViewBag.Sort" asp-route-direction="@ViewBag.Direction">Trước</a><a class="btn btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-route-page="@(Model.Page + 1)" asp-route-search="@ViewBag.Search" asp-route-action="@ViewBag.Action" asp-route-resource="@ViewBag.Resource" asp-route-actorId="@ViewBag.ActorId" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" asp-route-sort="@ViewBag.Sort" asp-route-direction="@ViewBag.Direction">Sau</a></div></div>
