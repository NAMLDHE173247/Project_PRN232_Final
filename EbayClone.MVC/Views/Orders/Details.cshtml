@model OrderDetailViewModel
@{ ViewData["Title"] = $"Đơn hàng #{Model.OrderId}"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title mb-0">Đơn hàng #@Model.OrderId</h1><a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a></div>
<div class="panel mb-3"><div class="row g-3"><div class="col-md-3"><span class="text-muted">Buyer</span><div>@Model.BuyerName</div><small>@Model.BuyerEmail</small></div><div class="col-md-3"><span class="text-muted">Status</span><div>@Model.Status</div></div><div class="col-md-3"><span class="text-muted">Ngày</span><div>@Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")</div></div><div class="col-md-3"><span class="text-muted">Tổng tiền</span><div>@Model.TotalAmount.ToString("N0")</div></div></div></div>
<div class="panel mb-3 table-responsive"><h2 class="h5">Sản phẩm</h2><table class="table"><thead><tr><th>Product</th><th>Số lượng</th><th>Đơn giá</th></tr></thead><tbody>@foreach (var item in Model.Items){<tr><td>@item.ProductName (#@item.ProductId)</td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("N0")</td></tr>}</tbody></table></div>
<div class="row g-3"><div class="col-lg-6"><div class="panel h-100"><h2 class="h5">Thanh toán</h2>@foreach (var payment in Model.Payments){<p class="mb-1">@payment.Method · @payment.Status · @payment.Amount.ToString("N0") · @payment.PaidAt?.ToString("dd/MM/yyyy HH:mm")</p>}</div></div><div class="col-lg-6"><div class="panel h-100"><h2 class="h5">Vận chuyển</h2>@foreach (var item in Model.Shipping){<p class="mb-1">@item.Carrier · @item.TrackingNumber · @item.Status</p>}</div></div></div>
