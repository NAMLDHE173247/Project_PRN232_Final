@model PagedViewModel<AdminReviewViewModel>
@{ ViewData["Title"] = "Reviews"; }
<h1 class="page-title">Giám sát Reviews</h1>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>ID</th><th>Product</th><th>Reviewer</th><th>Rating</th><th>Comment</th><th>Status</th><th>Ngày tạo</th><th></th></tr></thead><tbody>
@foreach (var review in Model.Items)
{
    <tr><td>#@review.Id</td><td>#@review.ProductId</td><td>#@review.ReviewerId</td><td><strong>@review.Rating / 5</strong></td><td>@review.Comment</td><td>@review.ModerationStatus</td><td>@review.CreatedAt?.ToString("dd/MM/yyyy")</td><td><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@review.Id">Chi tiết</a></td></tr>
}
</tbody></table></div>
<div class="mt-3 d-flex justify-content-between"><span class="text-muted">Trang @Model.Page / @Model.TotalPages · @Model.Total bản ghi</span><div class="btn-group"><a class="btn btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-route-page="@(Model.Page - 1)">Trước</a><a class="btn btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-route-page="@(Model.Page + 1)">Sau</a></div></div>
