@model AdminReviewViewModel
@{ ViewData["Title"] = $"Review #{Model.Id}"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title mb-0">Review #@Model.Id</h1><a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a></div>
<div class="panel"><div class="row g-3"><div class="col-md-3"><span class="text-muted">Product</span><div>#@Model.ProductId</div></div><div class="col-md-3"><span class="text-muted">Reviewer</span><div>#@Model.ReviewerId</div></div><div class="col-md-3"><span class="text-muted">Rating</span><div><strong>@Model.Rating / 5</strong></div></div><div class="col-md-3"><span class="text-muted">Status</span><div><strong>@Model.ModerationStatus</strong></div></div></div><hr /><h2 class="h6">Nội dung</h2><p>@Model.Comment</p>@if(Model.ModerationStatus=="Visible"){<form asp-action="Hide" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@Model.Id"/><input class="form-control" name="reason" required minlength="3" maxlength="500" placeholder="Moderation reason"/><button class="btn btn-danger">Hide</button></form>}else{<p>@Model.ModerationReason</p><form asp-action="Restore" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-success">Restore</button></form>}</div>
