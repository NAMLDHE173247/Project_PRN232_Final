@model PagedViewModel<DisputeViewModel>
@{ ViewData["Title"] = "Khiếu nại"; }
<h1 class="page-title">Quản lý khiếu nại</h1>
<form method="get" class="panel mb-3 row g-2 align-items-end"><div class="col-sm-5 col-lg-3"><label class="form-label" for="status">Trạng thái</label><select class="form-select" id="status" name="status"><option value="">Tất cả</option>@foreach (var value in new[] { "Open", "Assigned", "InReview", "Resolved", "Rejected" }){<option value="@value" selected="@(ViewBag.Status == value)">@value</option>}</select></div><div class="col-auto"><button class="btn btn-primary">Lọc</button></div></form>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>ID</th><th>Order</th><th>Người tạo</th><th>Mô tả</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var dispute in Model.Items)
{
    <tr><td>#@dispute.Id</td><td>#@dispute.OrderId</td><td>@dispute.RaisedByName</td><td>@dispute.Description</td><td><span class="badge-status status-@dispute.Status?.ToLowerInvariant()">@dispute.Status</span></td><td><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@dispute.Id">Chi tiết</a></td></tr>
}
</tbody></table></div>
<div class="mt-3 d-flex justify-content-between"><span class="text-muted">Trang @Model.Page / @Model.TotalPages · @Model.Total bản ghi</span><div class="btn-group"><a class="btn btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-route-page="@(Model.Page - 1)" asp-route-status="@ViewBag.Status">Trước</a><a class="btn btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-route-page="@(Model.Page + 1)" asp-route-status="@ViewBag.Status">Sau</a></div></div>
